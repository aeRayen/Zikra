# Copy to .env and fill locally. NEVER commit .env.
# Values below are placeholders only.

# --- Supabase (client-side, public by design; protected by RLS) ---
# Local dev (supabase start) prints these values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key

# --- Supabase (server-side ONLY: CI secrets / Edge Functions; never in the app) ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# --- Google Sign-In (package 1.12; public client id, not a secret) ---
GOOGLE_WEB_CLIENT_ID=

# --- Content packs CDN (package 1.15) ---
CONTENT_CDN_BASE_URL=https://cdn.example.invalid
# Path to the Ed25519 private key on the content-build machine (never committed)
CONTENT_SIGNING_KEY_PATH=

# --- Crash reporting (opt-in in app; ADR-010) ---
CRASH_REPORTING_DSN=
