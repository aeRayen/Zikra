# Normalize line endings to LF in the repository
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.webp binary
*.ttf  binary
*.otf  binary
*.jar  binary
*.sqlite binary
*.db   binary
*.mp3  binary
*.opus binary

# Religious content sources must stay byte-identical (pinned SHA-256 in content/sources/SOURCES.lock.json)
content/sources/** -text -diff
