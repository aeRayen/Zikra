{
  "project": "Islamic Life OS",
  "platforms": [
    "Android first",
    "iOS later"
  ],
  "deployment": "self-hosted backend",
  "architecture": {
    "android": "Kotlin, Jetpack Compose, modular clean architecture",
    "backend": "modular monolith",
    "database": "PostgreSQL server, Room local",
    "api": "REST + OpenAPI"
  },
  "features": [
    {
      "id": "authentication",
      "priority": "P0",
      "scope": [
        "Google sign-in",
        "session lifecycle",
        "account deletion",
        "optional sync"
      ]
    },
    {
      "id": "home",
      "priority": "P0",
      "scope": [
        "daily dashboard",
        "customizable cards",
        "RTL",
        "dark/light mode"
      ]
    },
    {
      "id": "prayer_times",
      "priority": "P0",
      "scope": [
