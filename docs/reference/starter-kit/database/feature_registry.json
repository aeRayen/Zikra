        "adhan notifications",
        "timezone handling",
        "offline calculation"
      ]
    },
    {
      "id": "qibla",
      "priority": "P0",
      "scope": [
        "sensor compass",
        "calibration guidance",
        "fallback behavior"
      ]
    },
    {
