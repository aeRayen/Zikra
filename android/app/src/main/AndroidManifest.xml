<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network: optional account + sync (ADR-024) and signed content packs. Every request goes
         through NetworkGate (core:network): guests never reach account or sync endpoints. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- WP 2.1 (ADR-018): APPROXIMATE location only, requested when the user taps «Use my approximate location». -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- WP 2.5: prayer-time alerts (Android 13+ asks the user; requested with an explanation). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional hardware: the app must install on phones without them (city search and the
         Qibla angle work without location hardware or a compass). Location features would
         otherwise be implied as required by ACCESS_COARSE_LOCATION. -->
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <!-- Each further permission is added by the work package that needs it,
         with an in-app rationale (DESIGN_SYSTEM_AR.md, UX rules). -->

    <application
        android:name=".ZikraApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Persists the per-app language on Android 12 and lower (AppCompat). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <!-- Next-prayer home-screen widget (WP 2.17). Only the system sends APPWIDGET_UPDATE. -->
        <receiver
            android:name=".widget.PrayerWidgetProvider"
            android:exported="true"
            android:label="@string/prayer_next_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_prayer_info" />
        </receiver>
    </application>
</manifest>
