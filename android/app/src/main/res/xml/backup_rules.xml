<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower (ADR-006): same exclusions as data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="database" path="private.db" />
    <exclude domain="database" path="private.db-wal" />
    <exclude domain="database" path="private.db-shm" />
    <exclude domain="sharedpref" path="secure_session.xml" />
    <exclude domain="file" path="datastore/location.json" />
</full-backup-content>
