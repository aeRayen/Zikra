<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup / device-transfer rules (ADR-006).
     private.db (recovery & protection, SQLCipher) must NEVER be backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="private.db" />
        <exclude domain="database" path="private.db-wal" />
        <exclude domain="database" path="private.db-shm" />
        <exclude domain="sharedpref" path="secure_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="private.db" />
        <exclude domain="database" path="private.db-wal" />
        <exclude domain="database" path="private.db-shm" />
        <exclude domain="sharedpref" path="secure_session.xml" />
    </device-transfer>
</data-extraction-rules>
